{
  "manifest_version": 3,
  "name": "Peek-a-boo Bridge",
  "version": "2.0.0",
  "description": "Mirrors the YouTube video playing in Chrome into the Peek-a-boo desktop island.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "ws://127.0.0.1/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}